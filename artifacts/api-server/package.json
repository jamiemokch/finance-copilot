{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:baseline-safe": "pnpm run test:ingestion && pnpm run test:spreadsheet-ai && pnpm run test:guided-review-dom && pnpm run test:spreadsheet-timeout-ui && pnpm run test:bank-csv && pnpm run test:self-assessment && pnpm run test:auth-bootstrap && pnpm run test:evidence-detach-refresh && pnpm run test:financial-memory-predicate",
    "test:ingestion": "esbuild src/lib/spreadsheet.test.ts --bundle --platform=node --format=cjs --outfile=dist/spreadsheet.test.cjs && node --test dist/spreadsheet.test.cjs",
    "test:spreadsheet-ai": "esbuild src/lib/ai.test.ts --bundle --platform=node --format=cjs --outfile=dist/ai.test.cjs && node --test dist/ai.test.cjs",
    "check:spreadsheet-provider": "node ./scripts/run-spreadsheet-provider-compatibility-check.mjs",
    "check:spreadsheet-provider-positive": "pnpm exec esbuild src/lib/spreadsheet-provider-positive-semantic-check-cli.ts --bundle --platform=node --format=cjs --outfile=dist/spreadsheet-provider-positive-semantic-check.cjs && node dist/spreadsheet-provider-positive-semantic-check.cjs",
    "test:guided-review-dom": "esbuild ../sme-finance-copilot/src/components/guided-spreadsheet-audit.test.tsx --bundle --platform=node --format=cjs --outfile=dist/guided-spreadsheet-audit.test.cjs && node --test dist/guided-spreadsheet-audit.test.cjs",
    "test:spreadsheet-timeout-ui": "esbuild ../sme-finance-copilot/src/lib/spreadsheet-review-status.test.ts --bundle --platform=node --format=cjs --outfile=dist/spreadsheet-review-status.test.cjs && node --test dist/spreadsheet-review-status.test.cjs",
    "test:bank-csv": "esbuild src/lib/bank-csv.test.ts --bundle --platform=node --format=cjs --outfile=dist/bank-csv.test.cjs && node --test dist/bank-csv.test.cjs",
    "test:bank-import-safety": "node ./scripts/run-bank-import-safety-test.mjs",
    "test:evidence-safety": "node ./scripts/run-evidence-safety-test.mjs",
    "test:uat-fresh-user-reset": "node ./scripts/run-uat-fresh-user-reset-test.mjs",
    "test:reconciliation-safety": "node ./scripts/run-reconciliation-safety-test.mjs",
    "test:self-assessment": "esbuild src/lib/self-assessment-readiness.test.ts --bundle --platform=node --format=cjs --outfile=dist/self-assessment-readiness.test.cjs && node --test dist/self-assessment-readiness.test.cjs",
    "test:auth-bootstrap": "esbuild ../sme-finance-copilot/src/lib/auth-bootstrap.test.ts --bundle --platform=node --format=cjs --outfile=dist/auth-bootstrap.test.cjs && node --test dist/auth-bootstrap.test.cjs",
    "test:evidence-detach-refresh": "esbuild ../sme-finance-copilot/src/lib/evidence-detach.test.ts --bundle --platform=node --format=cjs --outfile=dist/evidence-detach.test.cjs && node --test dist/evidence-detach.test.cjs",
    "test:financial-memory-predicate": "esbuild ../sme-finance-copilot/src/lib/financial-memory.test.ts --bundle --platform=node --format=cjs --outfile=dist/financial-memory.test.cjs && node --test dist/financial-memory.test.cjs",
    "test:self-assessment-routes": "node ./scripts/run-self-assessment-route-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "openai": "^7.5.0",
    "openid-client": "^6.8.7",
    "pdf-parse": "^2.4.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "xlsx": "^0.18.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
